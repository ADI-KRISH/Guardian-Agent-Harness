digraph risk {
  rankdir=LR; graph [fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.6, label="Risk paths: shop-api@1.4.0 (findings >= high)", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor=white, color="#9aa1a9"];
  edge [color="#9aa1a9", arrowsize=0.6];
  "root" [label="shop-api@1.4.0", fillcolor="#0f2537", fontcolor=white, color="#0f2537"];
  "pkg:docker/fastbuilds/node-runtime@18" [label="fastbuilds/node-runtime@18\n1 finding · high", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Image 'fastbuilds/node-runtime' comes from a non-allowlisted publisher (docker.io)", shape=component];
  "pkg:githubactions/quick-actions/npm-cache@main" [label="quick-actions/npm-cache@main\n1 finding · high\n(ci)", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] GitHub Action quick-actions/npm-cache: branch/unversioned ref 'main' (code changes on every run)", style="rounded,filled,dashed", shape=component];
  "pkg:npm/body-parser@1.19.0" [label="body-parser@1.19.0\n2 findings · high", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in body-parser@1.19.0: body-parser vulnerable to Denial of Service via trailing bytes after a compressed request body
[high] Known vulnerability in body-parser@1.19.0: body-parser vulnerable to denial of service when url encoding is enabled"];
  "pkg:npm/crossenv@6.1.1" [label="crossenv@6.1.1\n3 findings · critical\n(dev)", fillcolor="#f9dedc", color="#b3261e", penwidth=2, tooltip="[critical] Suspicious install script in crossenv@6.1.1
[critical] crossenv was taken down by npm security (malicious package)
[high] Possible typosquat: 'crossenv' looks like 'cross-env'", style="rounded,filled,dashed"];
  "pkg:npm/debug-helper-utils@1.0.2" [label="debug-helper-utils@1.0.2\n1 finding · high", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Lockfile root declares 'debug-helper-utils' which is not in package.json"];
  "pkg:npm/event-stream@3.3.6" [label="event-stream@3.3.6\n2 findings · critical", fillcolor="#f9dedc", color="#b3261e", penwidth=2, tooltip="[critical] Known vulnerability in event-stream@3.3.6: Critical severity vulnerability that affects event-stream and flatmap-stream
[high] event-stream@3.3.6 is not published on the registry (unpublished or fabricated version)"];
  "pkg:npm/express@4.17.1" [label="express@4.17.1"];
  "pkg:npm/flatmap-stream@0.1.1" [label="flatmap-stream@0.1.1\n3 findings · critical", fillcolor="#f9dedc", color="#b3261e", penwidth=2, tooltip="[critical] Known malicious package in flatmap-stream@0.1.1: Malicious Package in flatmap-stream
[critical] flatmap-stream was taken down by npm security (malicious package)
[critical] Known vulnerability in flatmap-stream@0.1.1: Critical severity vulnerability that affects event-stream and flatmap-stream"];
  "pkg:npm/glob@7.1.6" [label="glob@7.1.6\n(dev)", style="rounded,filled,dashed"];
  "pkg:npm/js-yaml@4.0.0" [label="js-yaml@4.0.0\n3 findings · high\n(dev)", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in js-yaml@4.0.0: JS-YAML: Quadratic CPU consumption in !!omap resolution (3.x and 4.x) — CVE-2026-59870 fix not backported
[high] Known vulnerability in js-yaml@4.0.0: js-yaml: YAML merge-key chains can force quadratic CPU consumption
[high] Known vulnerability in js-yaml@4.0.0: js-yaml: maxTotalMergeKeys does not limit CPU use for empty merge sources", style="rounded,filled,dashed"];
  "pkg:npm/lodash@4.17.15" [label="lodash@4.17.15\n5 findings · critical", fillcolor="#f9dedc", color="#b3261e", penwidth=2, tooltip="[critical] Integrity hash changed for unchanged version lodash@4.17.15
[critical] Lockfile hash for lodash@4.17.15 does not match the registry
[high] Known vulnerability in lodash@4.17.15: Command Injection in lodash
[high] Known vulnerability in lodash@4.17.15: Prototype Pollution in lodash
[high] Known vulnerability in lodash@4.17.15: lodash vulnerable to Code Injection via `_.template` imports key names"];
  "pkg:npm/minimatch@3.0.4" [label="minimatch@3.0.4\n4 findings · high\n(dev)", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in minimatch@3.0.4: minimatch ReDoS vulnerability
[high] Known vulnerability in minimatch@3.0.4: minimatch ReDoS: nested *() extglobs generate catastrophically backtracking regular expressions
[high] Known vulnerability in minimatch@3.0.4: minimatch has ReDoS: matchOne() combinatorial backtracking via multiple non-adjacent GLOBSTAR segments
[high] Known vulnerability in minimatch@3.0.4: minimatch has a ReDoS via repeated wildcards with non-matching literal in pattern", style="rounded,filled,dashed"];
  "pkg:npm/minimist@1.2.5" [label="minimist@1.2.5\n3 findings · critical", fillcolor="#f9dedc", color="#b3261e", penwidth=2, tooltip="[critical] Known vulnerability in minimist@1.2.5: Prototype Pollution in minimist
[high] Download source for minimist@1.2.5 changed: registry.npmjs.org -> registry.npmjs-cdn.com
[high] minimist@1.2.5 is fetched over plain HTTP"];
  "pkg:npm/mocha@8.4.0" [label="mocha@8.4.0\n(dev)", style="rounded,filled,dashed"];
  "pkg:npm/nanoid@3.1.20" [label="nanoid@3.1.20\n3 findings · high\n(dev)", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in nanoid@3.1.20: nanoid: Integer Overflow or Wraparound
[high] Known vulnerability in nanoid@3.1.20: nanoid: custom generators can loop indefinitely when size is zero
[high] Known vulnerability in nanoid@3.1.20: nanoid: non-secure generators can loop indefinitely with negative size", style="rounded,filled,dashed"];
  "pkg:npm/node-fetch@2.6.0" [label="node-fetch@2.6.0\n1 finding · high", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in node-fetch@2.6.0: node-fetch forwards secure headers to untrusted sites"];
  "pkg:npm/path-to-regexp@0.1.7" [label="path-to-regexp@0.1.7\n3 findings · high", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in path-to-regexp@0.1.7: path-to-regexp contains a ReDoS
[high] Known vulnerability in path-to-regexp@0.1.7: path-to-regexp outputs backtracking regular expressions
[high] Known vulnerability in path-to-regexp@0.1.7: path-to-regexp vulnerable to Regular Expression Denial of Service via multiple route parameters"];
  "pkg:npm/qs@6.7.0" [label="qs@6.7.0\n1 finding · high", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in qs@6.7.0: qs vulnerable to Prototype Pollution"];
  "pkg:npm/serialize-javascript@5.0.1" [label="serialize-javascript@5.0.1\n1 finding · high\n(dev)", fillcolor="#ffe8d9", color="#d9480f", penwidth=2, tooltip="[high] Known vulnerability in serialize-javascript@5.0.1: Serialize JavaScript is Vulnerable to RCE via RegExp.flags and Date.prototype.toISOString()", style="rounded,filled,dashed"];
  "pkg:npm/ua-parser-js@0.7.29" [label="ua-parser-js@0.7.29\n2 findings · critical", fillcolor="#f9dedc", color="#b3261e", penwidth=2, tooltip="[critical] Known malicious package in ua-parser-js@0.7.29: Embedded malware in ua-parser-js
[high] ua-parser-js@0.7.29 is not published on the registry (unpublished or fabricated version)"];
